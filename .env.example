# Service Configuration
PORT=10000
KEEP_ALIVE_INTERVAL=780

# Pipeline Configuration
LAYER_INDEX=0
TOTAL_LAYERS=80
CHUNK_CACHE_DIR=/tmp/tjit_chunks

# Universal PostgreSQL Transaction Pooler Connection String (Port 6543 / PgBouncer / Supavisor)
# Compatible with Supabase, Neon, AWS RDS Proxy, CockroachDB, or any standard Postgres Tx pooler
DATABASE_URL=postgresql://user:password@host:6543/dbname?sslmode=require
